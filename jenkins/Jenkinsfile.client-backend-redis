pipeline {
    agent any
    
    environment {
        PYTHON_VERSION = '3.11'
        BACKEND_DIR = 'backend'
        REDIS_DIR = 'redis'
        BUILD_DIR = '${WORKSPACE}/${BACKEND_DIR}'
        BACKUP_DIR = '${WORKSPACE}/backups'
        DOCKER_COMPOSE_FILE = "${WORKSPACE}/docker-compose.redis.yml"
        BACKEND_PORT = '5002'
        REDIS_PORT = '5003'
        REDIS_CONTAINER_NAME = 'redis-medilink-client'
        SLACK_CHANNEL = '#ci-cd'
        DEPLOYMENT_URL = "http://localhost:${BACKEND_PORT}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }
    
    triggers {
        pollSCM('H/5 * * * *') // Poll every 5 minutes
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out code from ${env.GIT_BRANCH}"
                    checkout scm
                    env.GIT_COMMIT_MSG = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_HASH = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Create Backup') {
            steps {
                script {
                    echo "Creating backup of previous build..."
                    sh """
                        mkdir -p ${BACKUP_DIR}
                        if [ -d "${BUILD_DIR}/app" ]; then
                            tar -czf ${BACKUP_DIR}/backend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz \
                                -C ${BUILD_DIR} app requirements.txt alembic.ini alembic/
                            echo "Backup created: backend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz"
                        fi
                    """
                }
            }
        }
        
        stage('Setup Python') {
            steps {
                script {
                    echo "Setting up Python ${PYTHON_VERSION}"
                    sh '''
                        set +e  # Don't exit on error initially
                        
                        # Check various Python commands
                        PYTHON_CMD=""
                        PYTHON_VERSION_CHECK=""
                        
                        # Try python3.11 first
                        if command -v python3.11 &> /dev/null; then
                            PYTHON_CMD="python3.11"
                            PYTHON_VERSION_CHECK=$(python3.11 --version 2>&1)
                            echo "Found python3.11: $PYTHON_VERSION_CHECK"
                        # Try python3
                        elif command -v python3 &> /dev/null; then
                            PYTHON_CMD="python3"
                            PYTHON_VERSION_CHECK=$(python3 --version 2>&1)
                            PYTHON_VER=$(echo "$PYTHON_VERSION_CHECK" | awk '{print $2}' | cut -d. -f1,2)
                            PYTHON_MAJOR=$(echo $PYTHON_VER | cut -d. -f1)
                            PYTHON_MINOR=$(echo $PYTHON_VER | cut -d. -f2)
                            
                            if [ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -ge 11 ]; then
                                echo "Found python3 (3.11+): $PYTHON_VERSION_CHECK"
                            else
                                echo "Found python3 but version is $PYTHON_VER (need 3.11+)"
                                PYTHON_CMD=""
                            fi
                        # Try python
                        elif command -v python &> /dev/null; then
                            PYTHON_VERSION_CHECK=$(python --version 2>&1)
                            if echo "$PYTHON_VERSION_CHECK" | grep -q "Python 3"; then
                                PYTHON_VER=$(echo "$PYTHON_VERSION_CHECK" | awk '{print $2}' | cut -d. -f1,2)
                                PYTHON_MAJOR=$(echo $PYTHON_VER | cut -d. -f1)
                                PYTHON_MINOR=$(echo $PYTHON_VER | cut -d. -f2)
                                
                                if [ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -ge 11 ]; then
                                    PYTHON_CMD="python"
                                    echo "Found python (3.11+): $PYTHON_VERSION_CHECK"
                                fi
                            fi
                        fi
                        
                        # If Python 3.11+ found, use it
                        if [ -n "$PYTHON_CMD" ]; then
                            echo "Using $PYTHON_CMD: $PYTHON_VERSION_CHECK"
                            
                            # Save Python path for subsequent stages
                            PYTHON_PATH=$(dirname $(which $PYTHON_CMD))
                            echo "${PYTHON_PATH}" > ${WORKSPACE}/.python_path
                            echo "$PYTHON_CMD" > ${WORKSPACE}/.python_cmd
                            
                            # Verify pip
                            $PYTHON_CMD -m pip --version 2>/dev/null || pip3 --version 2>/dev/null || echo "pip will be installed in virtual environment"
                            
                            set -e  # Re-enable exit on error
                            exit 0
                        fi
                        
                        # Python 3.11+ not found, try to install
                        set -e
                        echo "Python 3.11+ not found. Attempting installation..."
                        
                        # Try installing using deadsnakes PPA (Ubuntu/Debian)
                        if command -v apt-get &> /dev/null; then
                            echo "Detected Debian/Ubuntu system. Attempting to install Python 3.11..."
                            
                            # Try without sudo first (in case we have permissions)
                            if apt-get update 2>/dev/null && apt-get install -y python3.11 python3.11-venv python3.11-pip 2>/dev/null; then
                                PYTHON_CMD="python3.11"
                                PYTHON_PATH=$(dirname $(which python3.11))
                                echo "${PYTHON_PATH}" > ${WORKSPACE}/.python_path
                                echo "$PYTHON_CMD" > ${WORKSPACE}/.python_cmd
                                echo "Python 3.11 installed successfully: $(python3.11 --version)"
                                exit 0
                            fi
                        fi
                        
                        # Installation failed - provide clear error
                        echo ""
                        echo "=========================================="
                        echo "ERROR: Python 3.11+ is required but not found"
                        echo "=========================================="
                        echo "Please install Python 3.11+ on the Jenkins agent:"
                        echo ""
                        echo "For Ubuntu/Debian:"
                        echo "  sudo apt-get update"
                        echo "  sudo apt-get install -y python3.11 python3.11-venv python3.11-pip"
                        echo ""
                        echo "Or configure the Jenkins NodeJS/Python plugin to use Python 3.11"
                        echo "=========================================="
                        exit 1
                    '''
                }
            }
        }
        
        stage('Check Docker') {
            steps {
                script {
                    echo "Checking Docker availability..."
                    sh '''
                        if ! command -v docker &> /dev/null; then
                            echo "Docker is not installed. Please install Docker first."
                            exit 1
                        fi
                        if ! command -v docker-compose &> /dev/null && ! docker compose version &> /dev/null; then
                            echo "Docker Compose is not installed. Please install Docker Compose first."
                            exit 1
                        fi
                        docker --version
                        docker-compose --version || docker compose version
                    '''
                }
            }
        }
        
        stage('Deploy Redis') {
            steps {
                script {
                    echo "Deploying Redis on port ${REDIS_PORT}..."
                    sh """
                        # Stop existing Redis container if running
                        docker stop ${REDIS_CONTAINER_NAME} 2>/dev/null || true
                        docker rm ${REDIS_CONTAINER_NAME} 2>/dev/null || true
                        
                        # Stop using docker-compose if exists
                        cd ${WORKSPACE}
                        if [ -f "${DOCKER_COMPOSE_FILE}" ]; then
                            docker-compose -f ${DOCKER_COMPOSE_FILE} down 2>/dev/null || docker compose -f ${DOCKER_COMPOSE_FILE} down 2>/dev/null || true
                        fi
                        
                        # Start Redis on custom port
                        docker run -d \\
                            --name ${REDIS_CONTAINER_NAME} \\
                            -p ${REDIS_PORT}:6379 \\
                            -v redis-client-data:/data \\
                            --restart unless-stopped \\
                            redis:8.2 redis-server --appendonly yes
                        
                        # Wait for Redis to be ready
                        sleep 5
                        
                        # Verify Redis is running
                        docker exec ${REDIS_CONTAINER_NAME} redis-cli ping || {
                            echo "Redis health check failed!"
                            exit 1
                        }
                        
                        echo "Redis deployed successfully on port ${REDIS_PORT}!"
                    """
                }
            }
        }
        
        stage('Create Virtual Environment') {
            steps {
                dir(BACKEND_DIR) {
                    script {
                        echo "Creating virtual environment..."
                        sh '''
                            # Load Python path and command
                            if [ -f ${WORKSPACE}/.python_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.python_path):$PATH"
                            fi
                            if [ -f ${WORKSPACE}/.python_cmd ]; then
                                PYTHON_CMD=$(cat ${WORKSPACE}/.python_cmd)
                            else
                                PYTHON_CMD="python3"
                            fi
                            
                            if [ ! -d "venv" ]; then
                                $PYTHON_CMD -m venv venv
                            fi
                            . venv/bin/activate
                            pip install --upgrade pip
                        '''
                    }
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir(BACKEND_DIR) {
                    script {
                        echo "Installing Python dependencies..."
                        sh '''
                            # Load Python path
                            if [ -f ${WORKSPACE}/.python_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.python_path):$PATH"
                            fi
                            
                            . venv/bin/activate
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }
        
        stage('Database Migrations') {
            steps {
                dir(BACKEND_DIR) {
                    script {
                        echo "Running database migrations..."
                        sh '''
                            # Load Python path
                            if [ -f ${WORKSPACE}/.python_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.python_path):$PATH"
                            fi
                            
                            . venv/bin/activate
                            alembic upgrade head || echo "Migration failed or already up to date"
                        '''
                    }
                }
            }
        }
        
        stage('Deploy Backend') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Deploying backend to localhost:${BACKEND_PORT}..."
                    
                    sh """
                        # Load Python path
                        if [ -f ${WORKSPACE}/.python_path ]; then
                            export PATH="\$(cat ${WORKSPACE}/.python_path):\$PATH"
                        fi
                        
                        cd ${BUILD_DIR}
                        . venv/bin/activate
                        
                        # Install PM2 if not available
                        if ! command -v pm2 &> /dev/null; then
                            echo "Installing PM2..."
                            npm install -g pm2
                        fi
                        
                        # Stop existing backend process if running
                        pm2 stop medilink-client-backend || true
                        pm2 delete medilink-client-backend || true
                        
                        # Ensure port ${BACKEND_PORT} is available
                        echo "Checking port ${BACKEND_PORT}..."
                        lsof -ti:${BACKEND_PORT} | xargs kill -9 2>/dev/null || true
                        
                        # Start backend on port ${BACKEND_PORT}
                        echo "Starting backend on port ${BACKEND_PORT}..."
                        pm2 start venv/bin/python \\
                            --name "medilink-client-backend" \\
                            --cwd ${BUILD_DIR} \\
                            -- -m uvicorn app.main:app --host 0.0.0.0 --port ${BACKEND_PORT}
                        
                        # Save PM2 process list
                        pm2 save
                        
                        # Display PM2 status
                        pm2 status
                        
                        echo "Backend deployed successfully!"
                        echo "Access backend at: http://localhost:${BACKEND_PORT}"
                        echo "API docs at: http://localhost:${BACKEND_PORT}/docs"
                    """
                }
            }
            post {
                success {
                    script {
                        echo "Deployment successful!"
                        try {
                            sendSlackNotification('success')
                        } catch (Exception e) {
                            echo "Failed to send Slack notification: ${e.getMessage()}"
                        }
                    }
                }
                failure {
                    script {
                        echo "Deployment failed!"
                        try {
                            sendSlackNotification('failure')
                        } catch (Exception e) {
                            echo "Failed to send Slack notification: ${e.getMessage()}"
                        }
                    }
                }
            }
        }
        
        stage('Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Running health checks..."
                    sleep(time: 10, unit: 'SECONDS')
                    sh """
                        # Check backend
                        for i in {1..5}; do
                            echo "Backend health check attempt \$i..."
                            curl -f ${DEPLOYMENT_URL}/auth/health || curl -f ${DEPLOYMENT_URL}/docs || true
                            sleep 5
                        done
                        
                        # Check Redis
                        echo "Redis health check..."
                        docker exec ${REDIS_CONTAINER_NAME} redis-cli ping || echo "Redis check failed"
                    """
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Pipeline completed. Generating summary..."
                generateBuildSummary()
            }
        }
        success {
            script {
                echo "Pipeline succeeded!"
            }
        }
        failure {
            script {
                echo "Pipeline failed!"
                try {
                    sendSlackNotification('failure')
                } catch (Exception e) {
                    echo "Failed to send Slack notification: ${e.getMessage()}"
                }
            }
        }
        cleanup {
            script {
                try {
                    sh """
                        cd ${env.BACKUP_DIR}
                        ls -t | tail -n +11 | xargs rm -f || true
                    """
                } catch (Exception e) {
                    echo "Cleanup failed: ${e.getMessage()}"
                }
                cleanWs()
            }
        }
    }
}

// Helper function to send Slack notifications
def sendSlackNotification(String status) {
    try {
        withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
            def webhookUrl = env.SLACK_WEBHOOK_URL?.toString()?.trim()
            if (!webhookUrl || webhookUrl.isEmpty()) {
                echo "Slack webhook URL not configured, skipping notification"
                return
            }
            
            def color = status == 'success' ? 'good' : 'danger'
            def emoji = status == 'success' ? '✅' : '❌'
            def commitMsg = env.GIT_COMMIT_MSG ?: 'No commit message'
            def commitHash = env.GIT_COMMIT_HASH ?: 'unknown'
            def author = env.GIT_COMMIT_AUTHOR ?: 'Unknown'
            def branch = env.GIT_BRANCH ?: 'unknown'
            branch = branch.replaceAll('origin/', '').replaceAll('refs/heads/', '')
            
            def message = """
${emoji} *Client Backend + Redis Build ${status.toUpperCase()}*

*Commit:* ${commitHash}
*Message:* ${commitMsg}
*Author:* ${author}
*Branch:* ${branch}
*Build:* #${BUILD_NUMBER}
*Backend Port:* ${env.BACKEND_PORT}
*Redis Port:* ${env.REDIS_PORT}
*Duration:* ${currentBuild.durationString}
*Console:* ${env.BUILD_URL}console

${status == 'success' ? '🎉 Backend and Redis deployed successfully!' : '⚠️ Build failed. Please check the console logs.'}
""".stripIndent()
            
            sh """
                curl -X POST "${webhookUrl}" \\
                -H 'Content-Type: application/json' \\
                -d '{
                    "channel": "${env.SLACK_CHANNEL}",
                    "username": "Jenkins CI/CD",
                    "icon_emoji": ":jenkins:",
                    "attachments": [{
                        "color": "${color}",
                        "text": "${message.replace('"', '\\"').replace('\n', '\\n')}",
                        "mrkdwn_in": ["text"]
                    }]
                }'
            """
        }
    } catch (Exception e) {
        echo "Slack notification failed (credential may not be configured): ${e.getMessage()}"
    }
}

def generateBuildSummary() {
    def summary = """
========================================
Client Backend + Redis CI/CD Pipeline Summary
========================================
Build Number: ${BUILD_NUMBER}
Status: ${currentBuild.currentResult}
Branch: ${env.GIT_BRANCH}
Commit: ${env.GIT_COMMIT_HASH}
Author: ${env.GIT_COMMIT_AUTHOR}
Backend Port: ${env.BACKEND_PORT}
Redis Port: ${env.REDIS_PORT}
Duration: ${currentBuild.durationString}
Build URL: ${env.BUILD_URL}
========================================
""".stripIndent()
    
    echo summary
    writeFile file: 'build-summary.txt', text: summary
    archiveArtifacts artifacts: 'build-summary.txt', allowEmptyArchive: true
}

