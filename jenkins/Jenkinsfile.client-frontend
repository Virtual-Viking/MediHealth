pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18.x'
        FRONTEND_DIR = 'frontend'
        BUILD_DIR = '${WORKSPACE}/${FRONTEND_DIR}'
        BACKUP_DIR = '${WORKSPACE}/backups'
        FRONTEND_PORT = '5001'
        SLACK_CHANNEL = '#team2'
        DEPLOYMENT_URL = "http://localhost:5001"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }
    
    triggers {
        pollSCM('H/5 * * * *') // Poll every 5 minutes
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out code from ${env.GIT_BRANCH}"
                    checkout scm
                    env.GIT_COMMIT_MSG = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_HASH = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Create Backup') {
            steps {
                script {
                    echo "Creating backup of previous build..."
                    sh """
                        mkdir -p ${BACKUP_DIR}
                        if [ -d "${BUILD_DIR}/.next" ]; then
                            tar -czf ${BACKUP_DIR}/frontend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz \
                                -C ${BUILD_DIR} .next package.json package-lock.json
                            echo "Backup created: frontend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz"
                        fi
                    """
                }
            }
        }
        
        stage('Setup Node.js') {
            steps {
                script {
                    echo "Setting up Node.js ${NODE_VERSION}"
                    sh '''
                        set -e
                        
                        NODE_INSTALL_DIR="${WORKSPACE}/.nodejs"
                        NODE_VERSION="18.20.4"
                        
                        # Check if Node.js is already installed in our location
                        if [ -f "${NODE_INSTALL_DIR}/bin/node" ] && [ "$(${NODE_INSTALL_DIR}/bin/node --version | cut -d. -f1)" = "v18" ]; then
                            echo "Node.js 18.x already installed: $(${NODE_INSTALL_DIR}/bin/node --version)"
                            echo "npm version: $(${NODE_INSTALL_DIR}/bin/npm --version)"
                        # Check if node is in PATH and is version 18
                        elif command -v node &> /dev/null && node --version | grep -q "v18"; then
                            echo "Node.js 18.x found in PATH: $(node --version)"
                            echo "npm version: $(npm --version)"
                            # Save the existing node path
                            NODE_PATH=$(dirname $(which node))
                            echo "${NODE_PATH}" > ${WORKSPACE}/.node_path || true
                        else
                            echo "Installing Node.js ${NODE_VERSION}..."
                            
                            # Detect architecture
                            ARCH=$(uname -m)
                            case "$ARCH" in
                                x86_64) ARCH="x64" ;;
                                aarch64|arm64) ARCH="arm64" ;;
                                *) ARCH="x64" ;;
                            esac
                            
                            # Create installation directory (user-writable, no sudo needed)
                            mkdir -p ${NODE_INSTALL_DIR}
                            
                            # Download and install Node.js
                            if command -v curl &> /dev/null; then
                                echo "Downloading Node.js ${NODE_VERSION} for ${ARCH}..."
                                
                                # Check if xz is available
                                XZ_AVAILABLE=0
                                if command -v xz &> /dev/null; then
                                    XZ_AVAILABLE=1
                                    echo "xz utility found, using .tar.xz format"
                                else
                                    echo "xz utility not found, attempting to install xz-utils..."
                                    # Try to install xz-utils (may require sudo, but try without first)
                                    if command -v apt-get &> /dev/null; then
                                        if apt-get update 2>/dev/null && apt-get install -y xz-utils 2>/dev/null; then
                                            XZ_AVAILABLE=1
                                            echo "xz-utils installed successfully"
                                        else
                                            echo "Could not install xz-utils (may require sudo), using .tar.gz format instead"
                                            XZ_AVAILABLE=0
                                        fi
                                    else
                                        echo "apt-get not available, using .tar.gz format"
                                        XZ_AVAILABLE=0
                                    fi
                                fi
                                
                                # Download and extract based on xz availability
                                if [ "$XZ_AVAILABLE" = "1" ]; then
                                    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" -o /tmp/node.tar.xz
                                    echo "Extracting Node.js from .tar.xz..."
                                    tar -xJf /tmp/node.tar.xz -C /tmp
                                    TAR_FILE="/tmp/node.tar.xz"
                                else
                                    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.gz" -o /tmp/node.tar.gz
                                    echo "Extracting Node.js from .tar.gz..."
                                    tar -xzf /tmp/node.tar.gz -C /tmp
                                    TAR_FILE="/tmp/node.tar.gz"
                                fi
                                
                                echo "Installing to ${NODE_INSTALL_DIR}..."
                                cp -r /tmp/node-v${NODE_VERSION}-linux-${ARCH}/* ${NODE_INSTALL_DIR}/
                                
                                # Cleanup
                                rm -rf /tmp/node-v${NODE_VERSION}-linux-${ARCH} ${TAR_FILE}
                                
                                # Verify installation
                                if [ -f "${NODE_INSTALL_DIR}/bin/node" ]; then
                                    echo "Node.js installed successfully: $(${NODE_INSTALL_DIR}/bin/node --version)"
                                    echo "npm version: $(${NODE_INSTALL_DIR}/bin/npm --version)"
                                else
                                    echo "ERROR: Node.js installation verification failed"
                                    exit 1
                                fi
                            else
                                echo "ERROR: curl not available. Please install Node.js manually."
                                exit 1
                            fi
                        fi
                        
                        # Add to PATH for this session and save for future stages
                        if [ -d "${NODE_INSTALL_DIR}/bin" ]; then
                            export PATH="${NODE_INSTALL_DIR}/bin:$PATH"
                            echo "${NODE_INSTALL_DIR}/bin" > ${WORKSPACE}/.node_path
                        fi
                        
                        # Verify node is accessible
                        node --version
                        npm --version
                    '''
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir(FRONTEND_DIR) {
                    script {
                        echo "Installing npm dependencies..."
                        sh '''
                            # Ensure Node.js is in PATH
                            if [ -f ${WORKSPACE}/.node_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.node_path):$PATH"
                            fi
                            [ -d "${WORKSPACE}/.nodejs/bin" ] && export PATH="${WORKSPACE}/.nodejs/bin:$PATH"
                            
                            node --version
                            npm --version
                            npm ci
                        '''
                    }
                }
            }
        }
        
        stage('Lint') {
            steps {
                dir(FRONTEND_DIR) {
                    script {
                        echo "Running ESLint..."
                        sh '''
                            # Ensure Node.js is in PATH
                            if [ -f ${WORKSPACE}/.node_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.node_path):$PATH"
                            fi
                            [ -d "${WORKSPACE}/.nodejs/bin" ] && export PATH="${WORKSPACE}/.nodejs/bin:$PATH"
                            
                            npm run lint || true
                        '''
                    }
                }
            }
        }
        
        stage('Build') {
            steps {
                dir(FRONTEND_DIR) {
                    script {
                        echo "Building Next.js application..."
                        sh '''
                            # Ensure Node.js is in PATH
                            if [ -f ${WORKSPACE}/.node_path ]; then
                                export PATH="$(cat ${WORKSPACE}/.node_path):$PATH"
                            fi
                            [ -d "${WORKSPACE}/.nodejs/bin" ] && export PATH="${WORKSPACE}/.nodejs/bin:$PATH"
                            
                            export NODE_ENV=production
                            npm run build
                        '''
                    }
                }
            }
        }
        
        stage('Deploy') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Deploying frontend to localhost:${FRONTEND_PORT}..."
                    
                    sh """
                        # Ensure Node.js is in PATH
                        if [ -f ${WORKSPACE}/.node_path ]; then
                            export PATH="\$(cat ${WORKSPACE}/.node_path):\$PATH"
                        fi
                        [ -d "${WORKSPACE}/.nodejs/bin" ] && export PATH="${WORKSPACE}/.nodejs/bin:\$PATH"
                        
                        cd ${BUILD_DIR}
                        
                        # Install PM2 if not available
                        if ! command -v pm2 &> /dev/null; then
                            echo "Installing PM2..."
                            npm install -g pm2
                        fi
                        
                        # Stop existing frontend process if running
                        pm2 stop medilink-client-frontend || true
                        pm2 delete medilink-client-frontend || true
                        
                        # Ensure port ${FRONTEND_PORT} is available
                        echo "Checking port ${FRONTEND_PORT}..."
                        lsof -ti:${FRONTEND_PORT} | xargs kill -9 2>/dev/null || true
                        
                        # Start frontend on port ${FRONTEND_PORT}
                        echo "Starting frontend on port ${FRONTEND_PORT}..."
                        PORT=${FRONTEND_PORT} pm2 start npm --name "medilink-client-frontend" -- start
                        
                        # Save PM2 process list
                        pm2 save
                        
                        # Display PM2 status
                        pm2 status
                        
                        echo "Frontend deployed successfully!"
                        echo "Access frontend at: http://localhost:${FRONTEND_PORT}"
                    """
                }
            }
            post {
                success {
                    script {
                        echo "Deployment successful!"
                        sendSlackNotification('success')
                    }
                }
                failure {
                    script {
                        echo "Deployment failed!"
                        sendSlackNotification('failure')
                    }
                }
            }
        }
        
        stage('Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Running health check..."
                    sleep(time: 10, unit: 'SECONDS')
                    sh """
                        for i in {1..5}; do
                            echo "Health check attempt \$i..."
                            curl -f ${DEPLOYMENT_URL} || curl -f ${DEPLOYMENT_URL}/api/health || true
                            sleep 5
                        done
                    """
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Pipeline completed. Generating summary..."
                generateBuildSummary()
            }
        }
        success {
            script {
                echo "Pipeline succeeded!"
                try {
                    sendSlackNotification('success')
                } catch (Exception e) {
                    echo "Failed to send Slack notification: ${e.getMessage()}"
                }
            }
        }
        failure {
            script {
                echo "Pipeline failed!"
                try {
                    sendSlackNotification('failure')
                } catch (Exception e) {
                    echo "Failed to send Slack notification: ${e.getMessage()}"
                }
            }
        }
        cleanup {
            script {
                try {
                    sh """
                        cd ${env.BACKUP_DIR}
                        ls -t | tail -n +11 | xargs rm -f || true
                    """
                } catch (Exception e) {
                    echo "Cleanup failed: ${e.getMessage()}"
                }
                cleanWs()
            }
        }
    }
}

// Helper function to send Slack notifications
def sendSlackNotification(String status) {
    try {
        withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
            def webhookUrl = env.SLACK_WEBHOOK_URL?.toString()?.trim()
            if (!webhookUrl || webhookUrl.isEmpty()) {
                echo "Slack webhook URL not configured, skipping notification"
                return
            }
            
            def color = status == 'success' ? 'good' : 'danger'
            def emoji = status == 'success' ? '✅' : '❌'
            def commitMsg = env.GIT_COMMIT_MSG ?: 'No commit message'
            def commitHash = env.GIT_COMMIT_HASH ?: 'unknown'
            def author = env.GIT_COMMIT_AUTHOR ?: 'Unknown'
            def branch = env.GIT_BRANCH ?: 'unknown'
            branch = branch.replaceAll('origin/', '').replaceAll('refs/heads/', '')
            
            def message = """
${emoji} *Client Frontend Build ${status.toUpperCase()}*

*Commit:* ${commitHash}
*Message:* ${commitMsg}
*Author:* ${author}
*Branch:* ${branch}
*Build:* #${BUILD_NUMBER}
*Port:* ${env.FRONTEND_PORT}
*Duration:* ${currentBuild.durationString}
*Console:* ${env.BUILD_URL}console

${status == 'success' ? '🎉 Frontend deployed successfully on port ' + env.FRONTEND_PORT + '!' : '⚠️ Build failed. Please check the console logs.'}
""".stripIndent()
            
            sh """
                curl -X POST "${webhookUrl}" \\
                -H 'Content-Type: application/json' \\
                -d '{
                    "channel": "${env.SLACK_CHANNEL}",
                    "username": "Jenkins CI/CD",
                    "icon_emoji": ":jenkins:",
                    "attachments": [{
                        "color": "${color}",
                        "text": "${message.replace('"', '\\"').replace('\n', '\\n')}",
                        "mrkdwn_in": ["text"]
                    }]
                }'
            """
        }
    } catch (Exception e) {
        echo "Slack notification failed (credential may not be configured): ${e.getMessage()}"
    }
}

def generateBuildSummary() {
    def summary = """
========================================
Client Frontend CI/CD Pipeline Summary
========================================
Build Number: ${BUILD_NUMBER}
Status: ${currentBuild.currentResult}
Branch: ${env.GIT_BRANCH}
Commit: ${env.GIT_COMMIT_HASH}
Author: ${env.GIT_COMMIT_AUTHOR}
Port: ${env.FRONTEND_PORT}
Duration: ${currentBuild.durationString}
Build URL: ${env.BUILD_URL}
========================================
""".stripIndent()
    
    echo summary
    writeFile file: 'build-summary.txt', text: summary
    archiveArtifacts artifacts: 'build-summary.txt', allowEmptyArchive: true
}

