pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18.x'
        PYTHON_VERSION = '3.11'
        ADMIN_FRONTEND_DIR = 'admin/frontend'
        ADMIN_BACKEND_DIR = 'admin/backend'
        ADMIN_FRONTEND_PORT = '5004'
        ADMIN_BACKEND_PORT = '5005'
        GRAFANA_PORT = '5006'
        PROMETHEUS_PORT = '5007'
        BACKUP_DIR = '${WORKSPACE}/backups'
        DOCKER_COMPOSE_PROMETHEUS = "${WORKSPACE}/admin/docker-compose.prometheus.yml"
        DOCKER_COMPOSE_GRAFANA = "${WORKSPACE}/docker-compose.grafana.yml"
        PROMETHEUS_CONTAINER = 'medilink-prometheus'
        GRAFANA_CONTAINER = 'medilink-grafana'
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
        SLACK_CHANNEL = '#ci-cd'
        ADMIN_FRONTEND_URL = "http://localhost:${ADMIN_FRONTEND_PORT}"
        ADMIN_BACKEND_URL = "http://localhost:${ADMIN_BACKEND_PORT}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }
    
    triggers {
        pollSCM('H/5 * * * *') // Poll every 5 minutes
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out code from ${env.GIT_BRANCH}"
                    checkout scm
                    env.GIT_COMMIT_MSG = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()
                    env.GIT_COMMIT_HASH = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        
        stage('Create Backup') {
            steps {
                script {
                    echo "Creating backup of previous build..."
                    sh """
                        mkdir -p ${BACKUP_DIR}
                        if [ -d "${ADMIN_FRONTEND_DIR}/.next" ]; then
                            tar -czf ${BACKUP_DIR}/admin-frontend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz \
                                -C ${ADMIN_FRONTEND_DIR} .next package.json package-lock.json
                        fi
                        if [ -d "${ADMIN_BACKEND_DIR}/app" ]; then
                            tar -czf ${BACKUP_DIR}/admin-backend-backup-${BUILD_NUMBER}-${env.GIT_COMMIT_HASH}.tar.gz \
                                -C ${ADMIN_BACKEND_DIR} app requirements.txt
                        fi
                    """
                }
            }
        }
        
        stage('Check Docker') {
            steps {
                script {
                    echo "Checking Docker availability..."
                    sh '''
                        if ! command -v docker &> /dev/null; then
                            echo "Docker is not installed. Please install Docker first."
                            exit 1
                        fi
                        if ! command -v docker-compose &> /dev/null && ! docker compose version &> /dev/null; then
                            echo "Docker Compose is not installed. Please install Docker Compose first."
                            exit 1
                        fi
                        docker --version
                        docker-compose --version || docker compose version
                    '''
                }
            }
        }
        
        stage('Deploy Prometheus') {
            steps {
                script {
                    echo "Deploying Prometheus on port ${PROMETHEUS_PORT}..."
                    sh """
                        # Stop existing Prometheus container
                        docker stop ${PROMETHEUS_CONTAINER} 2>/dev/null || true
                        docker rm ${PROMETHEUS_CONTAINER} 2>/dev/null || true
                        
                        # Stop using docker-compose if exists
                        if [ -f "${DOCKER_COMPOSE_PROMETHEUS}" ]; then
                            cd ${WORKSPACE}/admin
                            docker-compose -f docker-compose.prometheus.yml down 2>/dev/null || docker compose -f docker-compose.prometheus.yml down 2>/dev/null || true
                        fi
                        
                        # Start Prometheus on custom port
                        docker run -d \\
                            --name ${PROMETHEUS_CONTAINER} \\
                            -p ${PROMETHEUS_PORT}:9090 \\
                            -v ${WORKSPACE}/admin/prometheus.yml:/etc/prometheus/prometheus.yml:ro \\
                            --restart unless-stopped \\
                            prom/prometheus:latest
                        
                        # Wait for Prometheus to be ready
                        sleep 5
                        
                        echo "Prometheus deployed successfully on port ${PROMETHEUS_PORT}!"
                    """
                }
            }
        }
        
        stage('Deploy Grafana') {
            steps {
                script {
                    echo "Deploying Grafana on port ${GRAFANA_PORT}..."
                    sh """
                        # Stop existing Grafana container
                        docker stop ${GRAFANA_CONTAINER} 2>/dev/null || true
                        docker rm ${GRAFANA_CONTAINER} 2>/dev/null || true
                        
                        # Stop using docker-compose if exists
                        if [ -f "${DOCKER_COMPOSE_GRAFANA}" ]; then
                            docker-compose -f ${DOCKER_COMPOSE_GRAFANA} down 2>/dev/null || docker compose -f ${DOCKER_COMPOSE_GRAFANA} down 2>/dev/null || true
                        fi
                        
                        # Create necessary directories
                        mkdir -p ${WORKSPACE}/grafana/provisioning/datasources
                        mkdir -p ${WORKSPACE}/grafana/provisioning/dashboards
                        
                        # Start Grafana on custom port
                        docker run -d \\
                            --name ${GRAFANA_CONTAINER} \\
                            -p ${GRAFANA_PORT}:3000 \\
                            -e GF_SECURITY_ADMIN_USER=admin \\
                            -e GF_SECURITY_ADMIN_PASSWORD=\${GRAFANA_ADMIN_PASSWORD:-admin} \\
                            -e GF_SERVER_ROOT_URL=http://localhost:${GRAFANA_PORT} \\
                            -e GF_AUTH_ANONYMOUS_ENABLED=true \\
                            -e GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer \\
                            -e GF_SECURITY_ALLOW_EMBEDDING=true \\
                            -v grafana-storage:/var/lib/grafana \\
                            -v ${WORKSPACE}/grafana/provisioning:/etc/grafana/provisioning:ro \\
                            -v ${WORKSPACE}/grafana/dashboards:/var/lib/grafana/dashboards:ro \\
                            --restart unless-stopped \\
                            grafana/grafana:latest
                        
                        # Wait for Grafana to be ready
                        sleep 5
                        
                        echo "Grafana deployed successfully on port ${GRAFANA_PORT}!"
                    """
                }
            }
        }
        
        stage('Setup Node.js') {
            steps {
                script {
                    echo "Setting up Node.js ${NODE_VERSION}"
                    sh '''
                        if command -v node &> /dev/null; then
                            echo "Node.js already installed: $(node --version)"
                        else
                            echo "Installing Node.js..."
                            curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -
                            sudo apt-get install -y nodejs
                        fi
                        node --version
                        npm --version
                    '''
                }
            }
        }
        
        stage('Build Admin Frontend') {
            steps {
                dir(ADMIN_FRONTEND_DIR) {
                    script {
                        echo "Installing admin frontend dependencies..."
                        sh 'npm ci'
                        echo "Building admin frontend..."
                        sh 'npm run build'
                    }
                }
            }
        }
        
        stage('Setup Python') {
            steps {
                script {
                    echo "Setting up Python ${PYTHON_VERSION}"
                    sh '''
                        if command -v python3 &> /dev/null; then
                            echo "Python already installed: $(python3 --version)"
                        else
                            echo "Installing Python..."
                            sudo apt-get update
                            sudo apt-get install -y python3 python3-pip python3-venv
                        fi
                        python3 --version
                        pip3 --version
                    '''
                }
            }
        }
        
        stage('Setup Admin Backend') {
            steps {
                dir(ADMIN_BACKEND_DIR) {
                    script {
                        echo "Creating virtual environment..."
                        sh '''
                            if [ ! -d "venv" ]; then
                                python3 -m venv venv
                            fi
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }
        
        stage('Deploy Admin Services') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Deploying admin services..."
                    
                    // Deploy Admin Frontend
                    sh """
                        cd ${WORKSPACE}/${ADMIN_FRONTEND_DIR}
                        
                        # Install PM2 if not available
                        if ! command -v pm2 &> /dev/null; then
                            echo "Installing PM2..."
                            npm install -g pm2
                        fi
                        
                        # Stop existing admin frontend process
                        pm2 stop medilink-admin-frontend || true
                        pm2 delete medilink-admin-frontend || true
                        
                        # Ensure port ${ADMIN_FRONTEND_PORT} is available
                        lsof -ti:${ADMIN_FRONTEND_PORT} | xargs kill -9 2>/dev/null || true
                        
                        # Start admin frontend
                        PORT=${ADMIN_FRONTEND_PORT} pm2 start npm --name "medilink-admin-frontend" -- start
                        
                        echo "Admin frontend deployed on port ${ADMIN_FRONTEND_PORT}!"
                    """
                    
                    // Deploy Admin Backend
                    sh """
                        cd ${WORKSPACE}/${ADMIN_BACKEND_DIR}
                        . venv/bin/activate
                        
                        # Stop existing admin backend process
                        pm2 stop medilink-admin-backend || true
                        pm2 delete medilink-admin-backend || true
                        
                        # Ensure port ${ADMIN_BACKEND_PORT} is available
                        lsof -ti:${ADMIN_BACKEND_PORT} | xargs kill -9 2>/dev/null || true
                        
                        # Start admin backend
                        pm2 start venv/bin/python \\
                            --name "medilink-admin-backend" \\
                            --cwd ${WORKSPACE}/${ADMIN_BACKEND_DIR} \\
                            -- -m uvicorn app.main:app --host 0.0.0.0 --port ${ADMIN_BACKEND_PORT}
                        
                        # Save PM2 process list
                        pm2 save
                        pm2 status
                        
                        echo "Admin backend deployed on port ${ADMIN_BACKEND_PORT}!"
                    """
                }
            }
            post {
                success {
                    script {
                        echo "Deployment successful!"
                        sendSlackNotification('success')
                    }
                }
                failure {
                    script {
                        echo "Deployment failed!"
                        sendSlackNotification('failure')
                    }
                }
            }
        }
        
        stage('Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'prince'
                }
            }
            steps {
                script {
                    echo "Running health checks..."
                    sleep(time: 15, unit: 'SECONDS')
                    sh """
                        # Check admin frontend
                        echo "Checking admin frontend..."
                        curl -f ${ADMIN_FRONTEND_URL} || curl -f ${ADMIN_FRONTEND_URL}/api/health || true
                        
                        # Check admin backend
                        echo "Checking admin backend..."
                        curl -f ${ADMIN_BACKEND_URL}/docs || curl -f ${ADMIN_BACKEND_URL}/metrics || true
                        
                        # Check Prometheus
                        echo "Checking Prometheus..."
                        curl -f http://localhost:${PROMETHEUS_PORT}/api/v1/status/config || true
                        
                        # Check Grafana
                        echo "Checking Grafana..."
                        curl -f http://localhost:${GRAFANA_PORT}/api/health || true
                    """
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Pipeline completed. Generating summary..."
                generateBuildSummary()
            }
        }
        success {
            script {
                echo "Pipeline succeeded!"
            }
        }
        failure {
            script {
                echo "Pipeline failed!"
                sendSlackNotification('failure')
            }
        }
        cleanup {
            script {
                sh """
                    cd ${BACKUP_DIR}
                    ls -t | tail -n +11 | xargs rm -f || true
                """
                cleanWs()
            }
        }
    }
}

// Helper function to send Slack notifications
def sendSlackNotification(String status) {
    def webhookUrl = SLACK_WEBHOOK_URL?.toString()?.trim()
    if (!webhookUrl || webhookUrl.isEmpty()) {
        echo "Slack webhook URL not configured, skipping notification"
        return
    }
    
    def color = status == 'success' ? 'good' : 'danger'
    def emoji = status == 'success' ? '✅' : '❌'
    def commitMsg = env.GIT_COMMIT_MSG ?: 'No commit message'
    def commitHash = env.GIT_COMMIT_HASH ?: 'unknown'
    def author = env.GIT_COMMIT_AUTHOR ?: 'Unknown'
    def branch = env.GIT_BRANCH ?: 'unknown'
    branch = branch.replaceAll('origin/', '').replaceAll('refs/heads/', '')
    
    def message = """
${emoji} *Admin Panel Build ${status.toUpperCase()}*

*Commit:* ${commitHash}
*Message:* ${commitMsg}
*Author:* ${author}
*Branch:* ${branch}
*Build:* #${BUILD_NUMBER}
*Admin Frontend:* ${ADMIN_FRONTEND_PORT}
*Admin Backend:* ${ADMIN_BACKEND_PORT}
*Grafana:* ${GRAFANA_PORT}
*Prometheus:* ${PROMETHEUS_PORT}
*Duration:* ${currentBuild.durationString}
*Console:* ${env.BUILD_URL}console

${status == 'success' ? '🎉 Admin panel deployed successfully!' : '⚠️ Build failed. Please check the console logs.'}
""".stripIndent()
    
    sh """
        curl -X POST "${webhookUrl}" \\
        -H 'Content-Type: application/json' \\
        -d '{
            "channel": "${SLACK_CHANNEL}",
            "username": "Jenkins CI/CD",
            "icon_emoji": ":jenkins:",
            "attachments": [{
                "color": "${color}",
                "text": "${message.replace('"', '\\"').replace('\n', '\\n')}",
                "mrkdwn_in": ["text"]
            }]
        }'
    """
}

def generateBuildSummary() {
    def summary = """
========================================
Admin Panel CI/CD Pipeline Summary
========================================
Build Number: ${BUILD_NUMBER}
Status: ${currentBuild.currentResult}
Branch: ${env.GIT_BRANCH}
Commit: ${env.GIT_COMMIT_HASH}
Author: ${env.GIT_COMMIT_AUTHOR}
Admin Frontend Port: ${ADMIN_FRONTEND_PORT}
Admin Backend Port: ${ADMIN_BACKEND_PORT}
Grafana Port: ${GRAFANA_PORT}
Prometheus Port: ${PROMETHEUS_PORT}
Duration: ${currentBuild.durationString}
Build URL: ${env.BUILD_URL}
========================================
""".stripIndent()
    
    echo summary
    writeFile file: 'build-summary.txt', text: summary
    archiveArtifacts artifacts: 'build-summary.txt', allowEmptyArchive: true
}

