  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Appointments per day (by status)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" },
        "orientation": "horizontal",
        "barRadius": 2,
        "stacking": "normal",
        "showValue": "never",
        "xField": "Time",
        "yField": "Value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(appointments_created_total[1d]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Payments per method (last 7d, by status)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" },
        "orientation": "horizontal",
        "barRadius": 2,
        "stacking": "normal",
        "showValue": "never",
        "xField": "Time",
        "yField": "Value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, status) (increase(payments_total[7d]))",
          "legendFormat": "{{method}} {{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total collected (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(payments_amount_cents_total{status=\"succeeded\"}[7d])) / 100",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Commission (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(platform_commission_cents_total{status=\"succeeded\"}[7d])) / 100",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Signups / Logins (last 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 9 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, outcome) (increase(auth_events_total[1h]))",
          "legendFormat": "{{type}} {{outcome}}",
          "range": true
        }
      ]
    }
  ],
  "refresh": "30s",
